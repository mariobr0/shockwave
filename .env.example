# --- LLM Settings (Punctuation, formatting, typo-correction) ---
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT=25

# --- Speech Recognition (STT) Settings ---
# Engine: whisper or gigaam
STT_ENGINE=gigaam

# Whisper model name (e.g.: large-v3-turbo, medium, small, base, tiny)
WHISPER_MODEL=large-v3-turbo
# Whisper language: 'ru' (default), 'auto' (auto-detect 99 languages), 'en', 'de', etc.
WHISPER_LANGUAGE=ru

# GigaAM model name (e.g.: gigaam-v3-e2e-rnnt)
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
# GigaAM quantization: int8 (fast, 216 MB) or leave empty for float32 (885 MB)
GIGAAM_QUANTIZATION=int8

# --- Interface & Hotkeys ---
APP_LANGUAGE=en
HOTKEY=ctrl+space
UI_POSITION=bottom-left
LLM_NORM=false
ALERT_SOUND=true
WAKE_WORD_ENABLED=true
WAKE_WORD=мегатрон
CLIP_PREPEND=false
AI_TASK_MODE=false
TRANSLATE_EN=false
VOSK_MODEL_PATH=models/vosk-model-small-ru
VOSK_MODEL_URL=https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip
UI_OPACITY=0.80

# --- Theme & Colors (HEX) ---
CLI_QUOTE_COLOR=#514757
CLI_TITLE_COLOR=#B45FEB
UI_BG_COLOR=#3b274d
UI_GRIP_COLOR=#2c1c3b

# --- CLI Left Margins (Spaces) ---
CLI_BANNER_PAD=3
CLI_QUOTE_PAD=6
CLI_TITLE_PAD=14

# --- Customizable LLM Prompts (Optional) ---
# Override default system prompts if needed:
# LLM_PROMPT_TRANSLATE_EN="You are a professional translator and speech-to-text editor. Translate the dictated speech accurately and naturally into English. Format punctuation, fix typos, and preserve technical terms with proper English capitalization. Return ONLY the translation, without any explanations or conversational replies."
# LLM_PROMPT_AI_TASK="You are an expert AI prompt engineer. Transform the user's dictated speech into a clear, concise, and well-structured directive/prompt for an AI assistant. Remove conversational filler words ('ну', 'короче', 'смотри'). Formulate the objective clearly and highlight requirements. Return ONLY the final formatted prompt in the original language, without preamble or meta-commentary."
# LLM_PROMPT_AI_TASK_EN="You are an expert AI prompt engineer and translator. Transform the user's dictated speech into a clear, concise, and well-structured directive/prompt in English for an AI assistant. Remove conversational filler words. Formulate the core objective and specific requirements with proper technical terms. Return ONLY the final English prompt, without preamble or meta-commentary."


