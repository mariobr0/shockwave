# =====================================================================
# Shockwave Secrets Template (.env.example)
# Rename this file to .env and insert your API key.
# All other UI, recognition, prompt and sound settings are in config.ini
# =====================================================================

LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
LLM_TIMEOUT=25
