# --- Настройки LLM (исправление текста и пунктуации) ---
LLM_ENDPOINT=http://127.0.0.1:8045/v1/chat/completions
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.5-flash-lite

# --- Настройки распознавания речи (STT) ---
# Движок: whisper или gigaam
STT_ENGINE=gigaam

# Модель для Whisper (например: large-v3-turbo, medium, small, base, tiny)
WHISPER_MODEL=large-v3-turbo

# Модель для GigaAM (например: gigaam-v3-e2e-rnnt)
GIGAAM_MODEL=gigaam-v3-e2e-rnnt
# Квантование GigaAM: int8 (быстрая, 216 МБ) или пусто для float32 (885 МБ)
GIGAAM_QUANTIZATION=int8

# Локальные пути (если модели скачаны вручную в отдельную папку):
# WHISPER_MODEL_PATH=C:\models\whisper-large-v3-turbo
# GIGAAM_MODEL_PATH=C:\models\gigaam-v3-onnx

# --- Интерфейс и горячие клавиши ---
HOTKEY=f12
UI_POSITION=bottom-left
